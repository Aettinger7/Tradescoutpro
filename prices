<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Price Tracker | Neko the Samurai</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #0a0a0a;
      color: #f5f5f5;
      font-family: system-ui, -apple-system, sans-serif;
      background-image: radial-gradient(circle at 20% 30%, rgba(180,30,30,0.15), transparent 40%),
                        radial-gradient(circle at 80% 70%, rgba(180,30,30,0.1), transparent 40%);
    }
    .header {
      padding: 20px;
      text-align: center;
      position: relative;
    }
    .back {
      position: absolute;
      left: 20px;
      top: 25px;
      color: #e63946;
      text-decoration: none;
      font-size: 15px;
    }
    .back:hover { color: #ff6b6b; }
    h1 {
      margin: 10px 0 5px;
      font-size: 2.4rem;
      color: #d4af37;
      letter-spacing: 1px;
    }
    .subtitle {
      color: #ccc;
      margin-bottom: 30px;
      font-size: 1rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 25px;
      max-width: 1100px;
      margin: 0 auto 40px;
      padding: 0 20px;
    }
    .card {
      background: #141414;
      border: 1px solid #3a2f1d;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 0 15px rgba(180, 30, 30, 0.15);
    }
    .card h2 {
      margin: 0;
      padding: 14px 18px;
      background: #1a1a1a;
      font-size: 1.15rem;
      color: #d4af37;
      border-bottom: 1px solid #333;
    }
    iframe {
      width: 100%;
      height: 420px;
      border: none;
      display: block;
    }
    footer {
      text-align: center;
      padding: 25px 15px;
      font-size: 0.85rem;
      color: #888;
      border-top: 1px solid #222;
    }
  </style>
</head>
<body>
  <div class="header">
    <a href="/" class="back">← Back to Neko the Samurai</a>
    <h1>⚔ Live Price Tracker ⚔</h1>
    <p class="subtitle">$NEKO · Zenshin Clan · Bushido on Base</p>
  </div>

  <div class="grid">
    <!-- $NEKO Card -->
    <div class="card">
      <h2>$NEKO · Neko the Samurai</h2>
      <iframe src="https://dexscreener.com/base/0xb91f6f222d0eba27e552344157b8a98daa60df9e?embed=1&theme=dark&trades=0&info=0"></iframe>
    </div>

    <!-- Optional: $TOSHI Card (you can delete this whole div if you only want $NEKO) -->
    <div class="card">
      <h2>$TOSHI · Toshi the Emperor</h2>
      <iframe src="https://dexscreener.com/base/0x4b0Aaf3EBb163dd45F663b38b6d93f6093EBC2d3?embed=1&theme=dark&trades=0&info=0"></iframe>
    </div>
  </div>

  <footer>
    Prices are live from DexScreener on Base. Always DYOR.<br>
    Bushido is our path · $NEKO is a memecoin.
  </footer>
</body>
</html>
